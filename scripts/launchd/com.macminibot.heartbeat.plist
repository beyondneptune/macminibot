<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
macminibot heartbeat — fires scripts/heartbeat_writer.py every 60s.

Writes ~/macminibot/state/heartbeat.json with {ts_unix, pid, version}.
Dashboard reads that file to show "bot is alive (Ns ago)".

Load:
    launchctl bootstrap gui/$UID /Users/weeoto/macminibot/scripts/launchd/com.macminibot.heartbeat.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macminibot.heartbeat</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/weeoto/macminibot/.venv/bin/python</string>
        <string>-u</string>
        <string>/Users/weeoto/macminibot/scripts/heartbeat_writer.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/weeoto/macminibot</string>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/weeoto/macminibot/data/launchd_heartbeat.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/weeoto/macminibot/data/launchd_heartbeat.err</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
