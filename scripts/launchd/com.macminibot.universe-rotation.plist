<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Weekly leveraged-ETF universe rotation. Scans ~25 candidates, picks
top-8 by composite Sharpe+momentum-ATR. Writes data/active_universe.json.
Sundays 22:00 BST (after Friday close + weekend cushion).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macminibot.universe-rotation</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/weeoto/macminibot/.venv/bin/python</string>
        <string>-u</string>
        <string>/Users/weeoto/macminibot/scripts/110_universe_rotation.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string>/Users/weeoto/macminibot/src</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/weeoto/macminibot</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/weeoto/macminibot/data/launchd_universe_rotation.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/weeoto/macminibot/data/launchd_universe_rotation.err</string>
</dict>
</plist>
