<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Weekly per-asset signal/trail/PT picker. Mini train/test split per name.
Conservative fallback to default (buy_and_hold + 2.0σ + 3.0σ) when no
robust per-asset winner exists. Writes data/asset_overrides.json.
Sundays 23:00 BST (after universe-rotation).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macminibot.asset-config-rotation</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/weeoto/macminibot/.venv/bin/python</string>
        <string>-u</string>
        <string>/Users/weeoto/macminibot/scripts/112_asset_config_rotation.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string>/Users/weeoto/macminibot/src</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/weeoto/macminibot</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/weeoto/macminibot/data/launchd_asset_config_rotation.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/weeoto/macminibot/data/launchd_asset_config_rotation.err</string>
</dict>
</plist>
